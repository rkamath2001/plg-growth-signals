  "simpson_check": {
    "question": "Does 'desktop' really lift retention?",
    "aggregate_lift": 0.202,
    "within_segment_lift": {
      "enterprise_external": 0.01,
      "internal": 0.028,
      "self_serve": 0.008
    },
    "weighted_within_lift": 0.012,
    "adoption_by_segment": {
      "enterprise_external": 0.3,
      "internal": 0.9,
      "self_serve": 0.15
    },
    "confounded": true,
    "finding": "In aggregate, 'desktop' users retain +20% better, but inside each segment the difference is about +1%. The aggregate lift comes from mix: the internal rollout installed it by default. Do not claim it as a retention driver."
  },
