  "experiment": {
    "question": "Does outreach to product-qualified accounts cause conversions, and how should we test it?",
    "accounts_in_test": 200,
    "hot_accounts_in_test": 30,
    "true_effect": 0.04,
    "account_level_estimate": {
      "mean": 0.039,
      "p05": -0.021,
      "p95": 0.096
    },
    "user_level_estimate": {
      "mean": 0.016,
      "p05": -0.01,
      "p95": 0.042
    },
    "finding": "Randomizing by account recovers the true lift (~+4% vs a true +4%). Randomizing users inside the same company shows ~+2%, because colleagues share the outcome. Test sales plays at the account level, and keep a standing holdout so outreach can prove its own lift."
  },
  "sales_trigger": {
    "question": "How many independent adopters should a company have before we start an enterprise sales motion?",
    "baseline_conversion": 0.165,
    "recommended_rule": {
      "accounts_flagged": 156,
      "contracts_captured": 94,
      "precision": 0.603,
      "recall": 0.676,
      "f1": 0.637,
      "min_activated": 5,
      "min_functions": 1
    },
    "tied_rules": [
      "5+ users across 1+ functions",
      "5+ users across 2+ functions",
      "5+ users across 3+ functions"
    ],
    "signup_count_rule": {
      "accounts_flagged": 170,
      "contracts_captured": 77,
      "precision": 0.453,
      "recall": 0.554,
      "f1": 0.498,
      "min_signups": 9
    },
    "lift_over_baseline": 3.7,
    "tiers": {
      "sales_motion": {
        "rule": "5+ activated users",
        "accounts": 156,
        "conversion": 0.603
      },
      "warm_champion": {
        "rule": "4 activated users",
        "accounts": 93,
        "conversion": 0.226
      },
      "self_serve": {
        "rule": "fewer than 4",
        "accounts": 591,
        "conversion": 0.041
      }
    },
    "finding": "Start an enterprise sales motion at 5+ activated independent users. Those companies convert at 60% versus a 16% baseline (3.7x); the rule captures 68% of contracts while flagging 156 accounts. At 4 activated users conversion is 23%: run champion enablement there, not sales. Requiring a minimum number of functions did not beat the simple count within noise. The best sign-up-count rule scores F1 0.50 against 0.64, because sign-ups include event spikes that never activate.",
    "caveat": "Fit on 139 contracts: 3 rules are statistically tied, so the simplest was chosen. Counts only users resolvable to a company by email domain, so the true number of adopters is higher. Refit each quarter and by segment as outcomes accumulate.",
