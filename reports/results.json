    "w8_retention_internal_only": 0.759,
    "n_internal": 3500,
    "inflation_points": 5.9,
    "finding": "Including customer zero raises W8 retention from 27% to 33%. Report external users separately; internal use is mandated."
  },
  "activation_test": {
    "question": "Is activation the first agent action or the first question?",
