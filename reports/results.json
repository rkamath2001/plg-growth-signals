      0.311
    ],
    "lift_within_segment": {
      "enterprise_external": 0.305,
      "self_serve": 0.289
    },
    "finding": "Users who complete an agent action in week 0 retain at 45% at W8, vs 15% for question-only users (+30%, 95% CI +29% to +31%). The gap holds in every segment. Define activation as the first completed agent action.",
    "caveat": "Observational: high-intent users do both. Confirm with an onboarding experiment that nudges a first agent action."
  },
